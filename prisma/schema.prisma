generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Membres de la zaouia ────────────────────────────────────────────
// Chaque participant s'inscrit lui-même : prénom + sa zawiya (city).
// Les droits découlent du groupe et du rôle :
//   city  : NIMES (droits complets) | MONTPELLIER (lecture + participation)
//   role  : MEMBER < TREASURER (trésorerie) < REFERENT (gère la zawiya)
model Member {
  id            String         @id @default(cuid())
  name          String
  city          String         @default("NIMES") // NIMES | AVIGNON | MONTPELLIER
  role          String         @default("MEMBER") // MEMBER | TREASURER | REFERENT
  status        String         @default("ACTIVE") // ACTIVE | PENDING | BLOCKED
  pin           String? // SHA-256 du code personnel — null = à définir à l'entrée
  perms         String? // JSON {annonces,sondages,reunions,contenus,cotisations} — surcharges
  createdAt     DateTime       @default(now())
  attendances   Attendance[]
  contributions Contribution[]
  pollVotes     PollVote[]
  createdPolls  Poll[]         @relation("PollCreator")

  @@unique([name, city])
}

// ─── Réunions (Ijtima') ─────────────────────────────────────────────
model Meeting {
  id           String        @id @default(cuid())
  title        String // "Al-Ijtimâ' - Sadaqa"
  icon         String? // emoji / nom d'icône
  city         String?
  address      String?
  date         DateTime
  startTime    String? // "19:30"
  endTime      String? // "22:15"
  announcement String? // annonce du jour (corail)
  word         String? // "le mot"
  program      String? // JSON [{time,label,icon}]
  createdAt    DateTime      @default(now())
  attendances  Attendance[]
  polls        Poll[]
}

// ─── Présences (Je viendrai / invités) ──────────────────────────────
model Attendance {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  guests    Int      @default(0)
  note      String?
  createdAt DateTime @default(now())

  @@unique([meetingId, memberId])
}

// ─── Contributions (cotisations & ziyara) ───────────────────────────
// Nouveau modèle : chaque participant DÉCLARE la somme qu'il a mise
// (confirmedAt = null → en attente). Le référent cotisations (trésorier)
// voit la liste des cotisants et CONFIRME que la personne a donné.
model Contribution {
  id          String    @id @default(cuid())
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount      Float
  category    String    @default("COTISATION") // COTISATION | ZIYARA | DON
  date        DateTime  @default(now())
  note        String?
  recordedBy  String?
  confirmedAt DateTime? // null = déclarée, en attente de confirmation
  confirmedBy String? // prénom du référent qui a vu la somme
  createdAt   DateTime  @default(now())
}

// ─── Sondages (qui vient ?) ────────────────────────────────────────
model Poll {
  id        String     @id @default(cuid())
  question  String
  meetingId String? // optionnel : lié à une réunion
  meeting   Meeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  options   String? // JSON ["Oui","Non","Inch'Allah"]
  multiple  Boolean   @default(false)
  closesAt  DateTime?
  createdBy String?
  creator   Member?  @relation("PollCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  votes     PollVote[]
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  choice    String
  personnes Int      @default(0) // « Je viens » : 0 = pas concerné, 1 = seul, 2–5 = accompagné
  createdAt DateTime @default(now())

  @@unique([pollId, memberId])
}

// ─── Annonces affichées en tête ────────────────────────────────────
model Announcement {
  id        String   @id @default(cuid())
  title     String? // "-JEUDI- LATÎF AL-KABÎR"
  text      String
  color     String   @default("VERT") // VERT | CORAIL
  cities    String? // JSON des zawiya destinataires — null = toutes
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── Contenus (Adhkâr, Qur'ân, Samâ', Durûs) ───────────────────────
model ContentItem {
  id        String   @id @default(cuid())
  section   String // ADHKAR | QURAN | SAMA | DURUS
  title     String
  subtitle  String?
  body      String?
  url       String? // lien youtube pour samâ'
  icon      String?
  time      String? // "Après Maghreb"
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Réglages partagés (jours d'ijtima', etc.) ──────────────────────
model Setting {
  key   String @id
  value String // JSON
}

// ─── Journal de la zawiya (historique des actions) ─────────────────
model AuditLog {
  id        String   @id @default(cuid())
  kind      String // MEETING | CONTRIBUTION | ANNOUNCEMENT | POLL | MEMBER | ATTENDANCE | SETTING | CONTENT
  action    String // CREATE | UPDATE | DELETE | INSCRIRE | DESINSCRIRE | VOTE
  label     String // « Latîf al-Kabîr du 24 sept. »
  actor     String? // prénom de l'auteur (si connu)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
